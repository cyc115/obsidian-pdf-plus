{
    "name": "obsidian-pdf-plus",
    "version": "0.41.0-skim.2",
    "description": "The most Obsidian-native PDF annotation tool ever.",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "lint": "eslint src/ --ext .ts,.tsx",
        "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "pnpm build && wdio run ./wdio.conf.mts"
    },
    "keywords": [],
    "author": "Mike Chen (fork of PDF++ by Ryota Ushio)",
    "license": "MIT",
    "devDependencies": {
        "@cantoo/pdf-lib": "^2.4.3",
        "@capacitor/app": "^7.0.2",
        "@capacitor/core": "^7.4.3",
        "@capacitor/device": "^7.0.2",
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.34.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.3.0",
        "@typescript-eslint/eslint-plugin": "8.x",
        "@typescript-eslint/parser": "8.x",
        "@wdio/cli": "^9.31.9",
        "@wdio/globals": "^9.31.3",
        "@wdio/local-runner": "^9.31.9",
        "@wdio/mocha-framework": "^9.31.9",
        "@wdio/spec-reporter": "^9.31.2",
        "builtin-modules": "5.0.0",
        "electron": "^37.4.0",
        "esbuild": "0.25.9",
        "eslint": "^9.34.0",
        "globals": "^16.3.0",
        "mocha": "^12.0.1",
        "monkey-around": "^3.0.0",
        "obsidian": "latest",
        "p-limit": "^7.1.1",
        "pdfjs-dist": "^5.4.54",
        "tslib": "2.8.1",
        "typescript": "5.x",
        "vitest": "^5.0.0",
        "wdio-obsidian-reporter": "^3.2.0",
        "wdio-obsidian-service": "^3.2.0"
    }
}
